{
  "name": "vulnseal",
  "version": "0.1.0",
  "private": true,
  "description": "VulnSeal: privacy-preserving cross-platform bug bounty priority and dispute arbitration using blockchain commitments (research prototype, local-only).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "compile": "hardhat compile --config hardhat.config.cjs",
    "chain": "VS_CHAIN_INITIAL_DATE=2020-01-01T00:00:00Z hardhat node --config hardhat.config.cjs --hostname 127.0.0.1",
    "bootstrap": "node scripts/bootstrap.ts",
    "server": "node server/index.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "npm run compile && node --test --test-concurrency=1 tests/contract/*.test.ts tests/app/*.test.ts",
    "test:contract": "npm run compile && node --test --test-concurrency=1 tests/contract/*.test.ts",
    "test:app": "npm run compile && node --test --test-concurrency=1 tests/app/*.test.ts",
    "test:smoke": "node --test tests/smoke/*.test.ts",
    "benchmark": "node scripts/benchmark.ts",
    "integrity": "node scripts/integrity-check.ts",
    "verify-receipt": "node scripts/verify-receipt.ts",
    "verify-audit": "node scripts/verify-audit.ts",
    "ledger": "node scripts/show-chain.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.4.0",
    "qrcode": "1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "hardhat": "^2.29.1",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
